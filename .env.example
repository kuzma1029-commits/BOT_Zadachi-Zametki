# Telegram
BOT_TOKEN=your_telegram_bot_token

# GigaChat
GIGACHAT_AUTH_KEY=your_gigachat_auth_key
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Pro
# 0 — отключить проверку SSL (нужен Russian Trusted Root CA, если 1)
GIGACHAT_VERIFY_SSL=0

# Grist (MCP поверх Streamable HTTP, авторизация API-ключом)
GRIST_MCP_URL=https://docs.getgrist.com/api/mcp
GRIST_API_KEY=your_grist_api_key
GRIST_DOC_ID=your_grist_doc_id
GRIST_TASKS_TABLE=Задачи
GRIST_NOTES_TABLE=Заметки

# Идентификаторы колонок в Grist (label колонок)
GRIST_TEXT_COLUMN=Текст
GRIST_CATEGORY_COLUMN=Категория
GRIST_DATETIME_COLUMN=Время/Дата
GRIST_STATUS_COLUMN=Статус
